# SMTP credentials used by src/routes/api.contact.ts (nodemailer) to send
# the contact / consultation / work-with-us form submissions by email.
#
# Copy this file to .env for local development:
#   cp .env.example .env
# and fill in real values. For production (Vercel), add the same variables
# in Project Settings -> Environment Variables instead of committing .env.

# Gmail / Google Workspace SMTP.
SMTP_HOST=smtp.gmail.com

# Common ports: 587 (STARTTLS, recommended) or 465 (implicit TLS).
SMTP_PORT=587

# Set to "true" only if using port 465. Leave unset/false for port 587.
SMTP_SECURE=false

# Full mailbox login (usually the email address itself).
SMTP_USER=info@hempstonhome.com

# Gmail rejects the normal account password over SMTP — generate a 16-char
# App Password instead (requires 2-Step Verification enabled first):
# https://myaccount.google.com/apppasswords
SMTP_PASS=

# Optional overrides. MAIL_FROM defaults to SMTP_USER; MAIL_TO defaults to
# info@hempstonhome.com if not set.
MAIL_FROM=info@hempstonhome.com
MAIL_TO=info@hempstonhome.com
